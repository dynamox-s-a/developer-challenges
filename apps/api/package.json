{
  "name": "@dynamox/api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend NestJS do desafio Dynamox: ingestão idempotente de ciclos de telemetria e leitura de séries temporais.",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint src test --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "test:contract": "jest --runInBand --testPathPattern=contract",
    "test:unit": "jest --runInBand --testPathPattern=src",
    "test:e2e": "jest --runInBand --testPathPattern=test"
  },
  "dependencies": {
    "@dynamox/contracts": "0.1.0",
    "@dynamox/domain": "0.1.0",
    "@nestjs/common": "^10.4.7",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.7",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.7",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/client": "^5.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.8",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.7",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5"
  }
}

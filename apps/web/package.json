{
  "name": "@dynamox/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Frontend React + Vite + Material UI 5 do desafio Dynamox, com dashboard operacional de monitoramento de condição.",
  "scripts": {
    "dev": "vite",

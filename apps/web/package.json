    "@reduxjs/toolkit": "^2.2.8",
    "hono": "^4.11.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",

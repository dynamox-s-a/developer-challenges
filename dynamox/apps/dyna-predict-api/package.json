{
  "name": "@dynamox/dyna-predict-api",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "node",
          "outputPath": "apps/dyna-predict-api/dist",
          "format": [
            "cjs"
          ],
          "bundle": false,
          "main": "apps/dyna-predict-api/src/main.ts",
          "tsConfig": "apps/dyna-predict-api/tsconfig.app.json",
          "assets": [
            "apps/dyna-predict-api/src/assets"
          ],
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".js"
            }
          }
        },
        "configurations": {
          "development": {},
          "production": {
            "esbuildOptions": {
              "sourcemap": false,
              "outExtension": {
                ".js": ".js"
              }
            }
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/dyna-predict-api/dist/package.json",
          "{workspaceRoot}/apps/dyna-predict-api/dist/package-lock.json"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/dyna-predict-api/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@dynamox/dyna-predict-api:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@dynamox/dyna-predict-api:build:development"
          },
          "production": {
            "buildTarget": "@dynamox/dyna-predict-api:build:production"
          }
        }
      }
    }
  },
  "dependencies": {
    "@fastify/autoload": "~6.0.3",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/error": "^4.2.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "~6.0.2",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "@sentry/node": "^10.40.0",
    "bcrypt": "^6.0.0",
    "dayjs": "^1.11.19",
    "dotenv": "^17.3.1",
    "fast-glob": "^3.3.3",
    "fastify": "~5.2.1",
    "fastify-plugin": "~5.0.1",
    "http-status-codes": "^2.3.0",
    "pg": "^8.18.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/pg": "^8.16.0",
    "eslint": "^10.0.2",
    "lint-staged": "^16.2.7",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "prisma": "^7.4.1",
    "tsx": "^4.21.0"
  },
  "scripts": {
    "dev:build:types": "npx nx build @dynamox/types",
    "dev:db:generate": "prisma generate",
    "dev:db:migrate": "prisma migrate dev",
    "dev:db:reset": "prisma migrate reset",
    "dev:db:seed": "tsx prisma/seed.ts",
    "dev:db:seed:time-series": "tsx prisma/seed-time-series.ts",
    "dev:db:studio": "prisma studio",
    "prod:db:migrate": "prisma migrate deploy",
    "prod:db:seed": "NODE_ENV=production tsx prisma/seed.ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}

    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.18.0",
    "@prisma/client": "^5.22.0",
    "@reduxjs/toolkit": "^2.12.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^2.15.0",
    "zod": "^4.4.3"
  }
}

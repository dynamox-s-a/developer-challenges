{
  "name": "dynamox-full-stack-challenge",
  "version": "1.0.0",
  "private": true,
  "description": "Dynamox Full-Stack Developer Challenge — DynaPredict (machines, sensors, time-series)",
  "scripts": {
    "dev:api": "nx serve api",
    "dev:web": "nx serve web",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "test:e2e": "cypress run",
    "cypress:open": "cypress open",
    "test:load": "node scripts/load/run-load.mjs",
    "test:load:lb": "LOAD_BASE_URL=http://localhost:8080 node scripts/load/run-load.mjs",
    "prod:up": "docker compose -f docker-compose.prod.yml up --build -d --scale api=2",
    "prod:down": "docker compose -f docker-compose.prod.yml down",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "prisma:generate": "nx run api:prisma:generate",
    "prisma:migrate": "nx run api:prisma:migrate",
    "prisma:seed": "nx run api:prisma:seed"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kalvims/dynamox-fs-test.git"
  },
  "license": "ISC",
  "devDependencies": {
    "@nx/eslint": "^23.1.1",
    "@nx/eslint-plugin": "^23.1.1",
    "@nx/jest": "^23.1.1",
    "@nx/js": "^23.1.1",
    "@nx/node": "^23.1.1",
    "@nx/react": "^23.1.1",
    "@nx/vite": "^23.1.1",
    "@nx/vitest": "^23.1.1",
    "@nx/webpack": "^23.1.1",
    "@nx/workspace": "^23.1.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autocannon": "^8.0.0",
    "cypress": "^13.17.0",
    "jsdom": "^29.1.1",
    "nx": "^23.1.1",
    "prettier": "^3.9.6",
    "prisma": "^5.22.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vite": "5.4.19",
    "vitest": "^2.1.9"
  },

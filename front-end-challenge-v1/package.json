{
  "name": "front-end-challenge-v1",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "server": "json-server --watch db.json --port 3001",
    "dev:all": "concurrently \"npm run server\" \"npm run dev\"",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:headed": "cypress run --headed",
    "test:e2e": "concurrently --kill-others --success first \"npm run server\" \"npm run dev\" \"wait-on http://localhost:3000 && cypress run\"",
    "test:e2e:open": "concurrently \"npm run server\" \"npm run dev\" \"wait-on http://localhost:3000 && cypress open\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.2.2",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@reduxjs/toolkit": "^2.11.1",
    "axios": "^1.13.2",
    "json-server": "^1.0.0-beta.3",
    "next": "16.0.8",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-hook-form": "^7.68.0",
    "react-redux": "^9.2.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@testing-library/cypress": "^10.1.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^9.1.2",
    "cypress": "^15.7.1",
    "typescript": "^5",
    "wait-on": "^9.0.3",
    "storybook": "^10.1.5",
    "@storybook/nextjs-vite": "^10.1.5",
    "@chromatic-com/storybook": "^4.1.3",
    "@storybook/addon-vitest": "^10.1.5",
    "@storybook/addon-a11y": "^10.1.5",
    "@storybook/addon-docs": "^10.1.5",
    "@storybook/addon-onboarding": "^10.1.5",
    "vite": "^7.2.7",
    "vitest": "^4.0.15",
    "playwright": "^1.57.0",
    "@vitest/browser-playwright": "^4.0.15",
    "@vitest/coverage-v8": "^4.0.15"
  }
}

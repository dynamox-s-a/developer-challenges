# Local PostgreSQL connection for host-side Drizzle commands.
DATABASE_URL=postgresql://dynamox:dynamox_dev_only@localhost:5432/dynamox

# Docker Compose database settings. These credentials are development-only.
POSTGRES_DB=dynamox
POSTGRES_USER=dynamox
POSTGRES_PASSWORD=dynamox_dev_only
POSTGRES_PORT=5432

API_PORT=3000
WEB_PORT=5173

# Fixed challenge credentials. Keep only the scrypt hash on the API side.
AUTH_EMAIL=admin@dynamox.local
AUTH_PASSWORD_SALT=ZHluYW1veC1kZXYtc2FsdA==
AUTH_PASSWORD_HASH=q+15C3iVTh7UHaGBcAwbXsjT9/DnspRRfNdXqlfIe4AC870Xh71DEnApN8mKnfeni/uAoq6yY/stF689IMB1PA==
JWT_SECRET=dynamox-development-jwt-secret-change-me
JWT_EXPIRES_IN_SECONDS=900

# The browser talks to the API same-origin; Vite proxies /api to the API container. Set an origin
# here only to reach a remote API directly.
VITE_API_ORIGIN=
API_PROXY_TARGET=http://api:3000

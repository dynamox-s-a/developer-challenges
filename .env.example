# Copie para .env antes de subir o ambiente:  cp .env.example .env
# Este arquivo não contém segredos reais. Os valores abaixo são de desenvolvimento local.

# --- PostgreSQL (docker-compose) ---
# A porta 5433 é o padrão do projeto para não colidir com uma instalação de PostgreSQL
# já existente na máquina (5432). Ajuste se preferir outra porta.
POSTGRES_USER=dynamox
POSTGRES_PASSWORD=dynamox
POSTGRES_DB=dynamox_challenge
POSTGRES_PORT=5433

# --- Prisma / API ---
DATABASE_URL=postgresql://dynamox:dynamox@localhost:5433/dynamox_challenge?schema=public
API_PORT=3000

# --- Autenticação (JWT emitido pela própria API) ---
# Valor de desenvolvimento local; troque em qualquer ambiente compartilhado.
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=8h

# --- Alertas ---
# Avaliar as regras de alerta logo após o commit de cada ciclo ingerido (padrão: true).
# Desligue para carregar um histórico em massa e reconciliá-lo depois com `npm run alerts:backfill`.
ALERTS_EVALUATE_ON_INGEST=true
# Cadência da varredura de presença (sensor mudo / planta sem telemetria), em ms. 0 desliga.
ALERTS_PRESENCE_SWEEP_MS=300000

# --- Frontend ---
# Base da API consumida pelo web. Deve apontar somente para o backend local deste projeto.
VITE_API_BASE_URL=http://localhost:3000/api

# --- Credenciais de demonstração do seed ---
# O desafio pede login com e-mail e senha fixos. Estes valores são públicos e existem
# apenas para o avaliador conseguir entrar na aplicação; não são segredos de produção.
SEED_USER_EMAIL=analista@dynamox.local
SEED_USER_PASSWORD=Dynamox@2026
# Segundo usuário do seed, perfil VIEWER (somente leitura): usado para demonstrar o 403 nas
# mutações — reconhecer um alerta, por exemplo.
SEED_VIEWER_EMAIL=consulta@dynamox.local
SEED_VIEWER_PASSWORD=Consulta@2026

# --- Ferramentas (opcionais) ---
# Base usada por `npm run perf:latency` quando a API não está em localhost:3000.
# LATENCY_BASE_URL=http://localhost:3000/api
# Timeout dos POSTs do gêmeo digital (ms) e raiz da instalação ROS para a ponte rosbag.
# TWIN_HTTP_TIMEOUT_MS=20000
# TWIN_ROS_ROOT=/opt/ros/noetic

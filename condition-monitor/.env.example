# Copy to .env. These are development values, never used outside a local machine.

# PostgreSQL container (docker-compose.yml)
POSTGRES_USER=condition_monitor
POSTGRES_PASSWORD=condition_monitor
POSTGRES_DB=condition_monitor
POSTGRES_PORT=5432

# API database connections
DATABASE_URL=postgresql://condition_monitor:condition_monitor@localhost:5432/condition_monitor
DATABASE_URL_TEST=postgresql://condition_monitor:condition_monitor@localhost:5432/condition_monitor_test

# API
PORT=3000

# Fixed user created by the seed (assumption A1)
SEED_USER_EMAIL=operator@condition-monitor.test
SEED_USER_PASSWORD=Monitor-2026-dev

# Account the simulator logs in with (assumption C13): the seed user by default.
SIMULATOR_EMAIL=operator@condition-monitor.test
SIMULATOR_PASSWORD=Monitor-2026-dev

# Second account the end-to-end tests use, to check one user cannot reach another's data
E2E_USER2_EMAIL=inspector@condition-monitor.test
E2E_USER2_PASSWORD=Inspector-2026-dev

# Signs session tokens (ADR 0008). At least 32 characters; use a random value outside
# local development, for example: openssl rand -base64 48
JWT_SECRET=local-development-secret-change-me-outside-dev

  "scripts": {
    "dev": "nx run-many -t serve -p api web",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "build": "nx run-many -t build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:integration": "nx run-many -t test-integration",
    "db:migration": "nx run api:prisma-migration",
    "db:deploy": "nx run api:prisma-deploy",
    "simulate": "nx run simulator:build && node apps/simulator/dist/main.js",
    "db:seed": "nx run api:prisma-seed",
    "load:setup": "node load-tests/setup.mjs",
    "load:test": "node load-tests/run.mjs",
    "e2e": "node apps/web-e2e/run.mjs"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],

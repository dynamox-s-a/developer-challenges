{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "types": ["jest", "@testing-library/jest-dom"],
    "verbatimModuleSyntax": false,
    "erasableSyntaxOnly": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": true
  },
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/setupTests.ts"]
}

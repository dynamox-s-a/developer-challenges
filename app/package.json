{
  "name": "dynamox-sensor-dashboard",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c yellow,cyan \"npm:api:mock\" \"vite\"",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "start-server-and-test dev http://localhost:5173/data cypress:run",
    "cypress:open": "start-server-and-test dev http://localhost:5173/data cypress:ui",
    "cypress:ui": "cypress open",
    "cypress:run": "cypress run --browser electron",
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6006",
    "build-storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook build",
    "api:mock": "json-server db.json --port 3001",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern storybook-static --ignore-pattern work --ignore-pattern coverage",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "5.16.14",
    "@mui/material": "5.16.14",
    "@highcharts/react": "5.2.2",
    "@reduxjs/toolkit": "2.8.2",
    "highcharts": "13.0.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "7.7.1",
    "react-redux": "9.2.0",
    "redux-saga": "1.3.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.5.3",
    "@storybook/react-vite": "10.5.3",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "3.2.4",
    "concurrently": "9.2.0",
    "cypress": "15.19.0",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "jsdom": "26.1.0",
    "json-server": "1.0.0-beta.3",
    "storybook": "10.5.3",
    "start-server-and-test": "2.1.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.0.13",
    "vitest": "3.2.4"
  },
  "type": "module"
}

{
	"name": "dynamox-front-end-challenge",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"packageManager": "pnpm@9.15.4",
	"scripts": {
		"dev": "concurrently -n vite,api -c blue,green \"vite\" \"pnpm dev:api\"",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"check": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"dev:api": "json-server mock/db.json --port 3001",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"dev:web:e2e": "vite --mode e2e --host 127.0.0.1 --port 5173 --strictPort",
		"build:e2e": "tsc -b && vite build --mode e2e",
		"preview:e2e": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
		"typecheck:e2e": "tsc -p cypress/tsconfig.json",
		"e2e:open": "cypress open",
		"e2e:run": "cypress run",
		"e2e:run:preview": "cypress run --config baseUrl=http://127.0.0.1:4173",
		"e2e": "start-server-and-test \"pnpm dev:api\" http-get://127.0.0.1:3001/measurements \"pnpm dev:web:e2e\" http-get://127.0.0.1:5173/data \"pnpm e2e:open\"",
		"e2e:ci": "pnpm build:e2e && start-server-and-test \"pnpm dev:api\" http-get://127.0.0.1:3001/measurements \"pnpm preview:e2e\" http-get://127.0.0.1:4173/data \"pnpm e2e:run:preview\""
	},
	"dependencies": {
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@fontsource/roboto": "^5.3.0",
		"@mui/icons-material": "5",
		"@mui/material": "5",
		"@reduxjs/toolkit": "^2.12.0",
		"axios": "^1.19.0",
		"highcharts": "^13.0.0",
		"highcharts-react-official": "^3.2.3",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-redux": "^9.3.0",
		"react-router-dom": "^7.18.2",
		"redux-saga": "^1.5.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@storybook/addon-a11y": "^10.5.8",
		"@storybook/react-vite": "^10.5.8",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.4",
		"@types/node": "^22.15.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.4",
		"axe-core": "^4.13.0",
		"concurrently": "^10.0.5",
		"cypress": "15.20.1",
		"jsdom": "^30.0.1",
		"json-server": "1.0.0-beta.15",
		"redux-saga-test-plan": "^4.0.6",
		"start-server-and-test": "2.1.5",
		"storybook": "^10.5.8",
		"typescript": "~6.0.2",
		"vite": "^8.2.0",
		"vitest": "^4.1.10"
	}
}

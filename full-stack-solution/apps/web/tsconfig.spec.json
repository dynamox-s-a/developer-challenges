{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "target": "es2020",
    "lib": ["es2021", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"],
    "noEmit": true,
    "paths": {
      "@full-stack-solution/shared": ["../../libs/shared/src/index.ts"],
      "@web/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.d.ts", "src/**/*.spec.ts", "src/**/*.spec.tsx", "src/test/**/*.ts", "src/test/**/*.tsx", "vite.config.mts"]
}

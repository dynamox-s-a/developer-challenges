# Database credentials (required, choose your own values)
POSTGRES_USER=
POSTGRES_PASSWORD=

# Database settings (non-sensitive defaults)
POSTGRES_DB=dynamox
POSTGRES_PORT=5432

# Prisma connection string. Must match the credentials above:
# Format: postgresql://USER:PASSWORD@localhost:PORT/DB?schema=public
DATABASE_URL=

# API
PORT=3000

# Browser origins allowed to call the API, comma-separated.
# Leave EMPTY for local development: the dev server proxies /api, so the browser
# makes no cross-origin request and no CORS middleware is mounted at all.
# Set it only where the SPA is served from another origin than the API, e.g.
# CORS_ALLOWED_ORIGINS=https://my-app.vercel.app,https://my-app-git-main.vercel.app
CORS_ALLOWED_ORIGINS=
# Generate one with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Fixed login user created by the seed
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# Web app (Vite). Both are optional.

# Where the DEV SERVER forwards /api requests to. Only used by `nx serve web`
# (never by the build); change it if the API does not run on localhost:3000.
VITE_API_PROXY_TARGET=http://localhost:3000

# API origin baked into the browser bundle at BUILD time. Leave empty when the
# API and the static files are served from the same origin (then the app just
# calls /api on its own origin). Set it when they are deployed separately —
# and then the API needs that SPA origin in CORS_ALLOWED_ORIGINS.
VITE_API_URL=

# Copie este arquivo para ".env" (na mesma pasta) e ajuste os valores.
# O .env não vai para o Git: é lá que ficam os segredos de verdade.

# Conexão com o Postgres do docker-compose (porta 5433 no seu computador)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/dynapredict?schema=public"

# Chave que assina os tokens de login. Use um valor aleatório com 32+ caracteres.
# Para gerar um: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="troque-por-uma-chave-aleatoria-com-32-caracteres-ou-mais"

# Validade do token de login, em segundos (3600 = 1 hora)
JWT_EXPIRES_IN="3600"

# Usuário fixo de login, criado pelo seed (rode "npx prisma db seed" dentro de apps/api)
SEED_USER_EMAIL="admin@dynamox.com"
SEED_USER_PASSWORD="dynapredict123"


# Opcionais: endereço e porta da API (padrão: localhost e 3000)
# HOST="localhost"
# PORT="3000"
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// Os mesmos valores do machineTypeSchema do shared (Pump e Fan)
enum MachineType {
  Pump
  Fan
}

model Machine {
  id        String      @id @default(uuid())
  name      String      @db.VarChar(100)
  type      MachineType
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

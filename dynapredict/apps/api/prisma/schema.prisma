generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// Os mesmos valores do machineTypeSchema do shared (Pump e Fan).
// Em ordem alfabética de propósito: o Postgres ordena um enum pela ordem dos
// valores (veja a migration sort_machine_types_alphabetically)
enum MachineType {
  Fan
  Pump
}

model Machine {
  id               String            @id @default(uuid())
  name             String            @db.VarChar(100)
  type             MachineType
  monitoringPoints MonitoringPoint[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model MonitoringPoint {
  id         String       @id @default(uuid())
  name       String       @db.VarChar(100)
  machineId  String
  // Excluir a máquina exclui junto os pontos dela
  machine    Machine      @relation(fields: [machineId], references: [id], onDelete: Cascade)
  // No máximo um sensor por ponto
  sensor     Sensor?
  // Os dados que os sensores deste ponto enviaram
  timeSeries TimeSeries[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  // Deixa rápida a busca dos pontos de uma máquina
  @@index([machineId])
}

model Sensor {
  id                String          @id @default(uuid())
  // O "ID único" do sensor é o número de série (ex.: DyL4.01.A0000)
  serialNumber      String          @unique
  // TcAg, TcAs ou HF+. É texto porque "HF+" não é um nome válido de enum
  // no Prisma; a migration tem uma CHECK que só aceita esses três valores
  model             String
  // @unique: um ponto não pode ter dois sensores
  monitoringPointId String          @unique
  // Excluir o ponto exclui junto o sensor dele
  monitoringPoint   MonitoringPoint @relation(fields: [monitoringPointId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

// Uma série temporal: um lote de medições que um sensor enviou de uma vez
// (ex.: a temperatura de um dia). Fica no PONTO, e não no sensor, para o
// histórico continuar lá quando o sensor for trocado ou removido
model TimeSeries {
  id                 String             @id @default(uuid())
  // O que foi medido, ex.: "Temperatura" ou "Velocidade RMS"
  name               String             @db.VarChar(100)
  // A unidade dos valores, ex.: "°C" ou "mm/s" (opcional)
  unit               String?            @db.VarChar(20)
  // O sensor que estava no ponto quando os dados chegaram
  sensorSerialNumber String
  monitoringPointId  String
  // Excluir o ponto exclui junto as séries dele
  monitoringPoint    MonitoringPoint    @relation(fields: [monitoringPointId], references: [id], onDelete: Cascade)
  samples            TimeSeriesSample[]
  // Um resumo gravado junto com a série, que não muda depois de enviada:
  // assim a lista de séries não precisa contar as medições toda vez
  sampleCount        Int
  startedAt          DateTime
  endedAt            DateTime
  createdAt          DateTime           @default(now())

  // Deixa rápida a busca das séries de um ponto
  @@index([monitoringPointId])
}

// Uma medição da série: o instante e o valor medido
model TimeSeriesSample {
  timeSeriesId String
  // Excluir a série exclui junto as medições dela
  timeSeries   TimeSeries @relation(fields: [timeSeriesId], references: [id], onDelete: Cascade)
  timestamp    DateTime
  value        Float

  // A chave é a série + o instante: uma série não tem duas medições no
  // mesmo instante, e o índice já deixa as medições em ordem de tempo
  @@id([timeSeriesId, timestamp])
}
